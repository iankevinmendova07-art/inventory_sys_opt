# Copy these values into the hosting environment. Do not commit real secrets.
APP_ENV=production
DB_HOST=127.0.0.1
DB_NAME=inventory_sys_db
DB_USER=inventory_app
DB_PASS=replace-with-a-strong-password

# Optional Google Sheets sync. See "docs/google_sheets_school_details_sync.md".
# Configure an Apps Script web app, then add its /exec URL and shared secret.
SCHOOL_DETAILS_WEBHOOK_URL=
SCHOOL_DETAILS_WEBHOOK_SECRET=
